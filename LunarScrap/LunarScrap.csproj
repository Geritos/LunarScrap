<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
    <EmbeddedResource Include="Assets\iconBlueScrap.png" />
    <EmbeddedResource Include="Assets\t2tb.png" />
	</ItemGroup>
  
	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="*-*" />
    
		<PackageReference Include="R2API.Items" Version="*" />
    <PackageReference Include="R2API.Prefab" Version="*" />
		<PackageReference Include="R2API.Language" Version="*" />
    
    <PackageReference Include="DropPod-LookingGlass" Version="*" />
    <PackageReference Include="RiskOfBrainrot-MoreStats" Version="*" />
	</ItemGroup>

  <!-- Files inside the Thunderstore folder to be copied on Release builds -->
  <ItemGroup>
    <ThunderstoreFiles Include="..\Thunderstore\**\*.*" />
  </ItemGroup>

  <!-- After a Release build, copy the Thunderstore folder contents to the output and place the compiled dll into a LunarScrap folder -->
  <Target Name="PrepareThunderstoreRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Copying Thunderstore contents from '..\Thunderstore' to '$(OutputPath)'" Importance="High" />
    <MakeDir Directories="$(OutputPath)" />
    <Copy SourceFiles="@(ThunderstoreFiles)" DestinationFiles="@(ThunderstoreFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    
    <Message Text="Deleting debug/supplementary files from output: .pdb and .deps.json" Importance="High" />
    <!-- Delete the PDB and deps.json produced alongside the DLL in the output directory -->
    <Delete Files="$(OutputPath)$(TargetName).pdb;$(OutputPath)$(TargetName).deps.json" ContinueOnError="true" />
  </Target>

</Project>
